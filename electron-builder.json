{
  "appId": "com.tinicrud.desktop",
  "productName": "TiniCRUD Desktop",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "dist"
  },
  "files": [
    ".output/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "app/assets/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TiniCRUD Desktop"
  }
}

